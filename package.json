{
  "name": "markdocs",
  "private": true,
  "version": "0.1.0",
  "description": "Google-Docs-style editor for markdown files",
  "scripts": {
    "dev": "pnpm --filter @markdocs/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  }
}
